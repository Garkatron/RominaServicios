---
import "../styles/global.css";
import Rosa2 from "../assets/images/2Rosa.jpg";
import Monedas from "../assets/images/Monedas.jpg";
import VelaRosa from "../assets/images/VelaRosa.jpg";
import BlancoNegro from "../assets/images/VelasBlancoNegro.jpg";
import RominaFoto from "../assets/images/romina2.jpg";
import TarotIntuitivo from "../assets/images/tarot_intuitivo.png";
import Velomancia from "../assets/images/velomancia.png";
import GuiaIntuitiva from "../assets/images/guia_intuitiva.png";
import { Image } from "astro:assets";
import Navbar from "../components/Navbar.astro";
import data from "../data.json";

const toolImages: Record<string, ImageMetadata> = {
  "Tarot intuitivo": TarotIntuitivo,
  "Velomancia": Velomancia,
  "Guía intuitiva": GuiaIntuitiva,
};
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={`${data.site.tagline} — ${data.site.subtitle}`} />
    <title>{data.site.title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Navbar />

    <!-- ═══════════════════════════════════════════
         HERO
    ═══════════════════════════════════════════ -->
    <section class="hero">
      <div class="hero-grid">
        <!-- Columna izquierda: contacto -->
        <aside class="hero-contact fade-in" style="--delay: 0.1s">
          <p class="contact-eyebrow">Contacto directo</p>
          <div class="contact-links">
            <a href={data.contact.phoneHref} class="contact-item">
              <span class="contact-icon">📞</span>
              <span>{data.contact.phone}</span>
            </a>
            <a href={data.contact.whatsapp.url} target="_blank" class="contact-item">
              <span class="contact-icon">💬</span>
              <span>WhatsApp</span>
            </a>
            <a href={data.contact.tiktok.url} target="_blank" class="contact-item">
              <span class="contact-icon">🎵</span>
              <span>{data.contact.tiktok.label}</span>
            </a>
            <a href={data.contact.instagram.url} target="_blank" class="contact-item">
              <span class="contact-icon">📷</span>
              <span>{data.contact.instagram.label}</span>
            </a>
          </div>
          <a href={data.contact.whatsapp.url} target="_blank" class="btn-primary">
            Reservar sesión
          </a>
        </aside>

        <!-- Columna central: foto + headline -->
        <div class="hero-center fade-in" style="--delay: 0.2s">
          <div class="hero-image-wrap">
            <Image
              src={RominaFoto}
              alt="Romina Minguez"
              class="hero-image"
            />
            <div class="hero-image-ring"></div>
          </div>
          <div class="hero-text">
            <h1 class="hero-title">{data.site.tagline}</h1>
            <p class="hero-subtitle">{data.site.subtitle}</p>
          </div>
        </div>

        <!-- Columna derecha: testimonio destacado -->
        <aside class="hero-review fade-in" style="--delay: 0.3s">
          <p class="contact-eyebrow">Lo que dicen</p>
          <blockquote class="hero-quote">
            <p>"{data.testimonials.items[0].text.slice(0, 180)}…"</p>
            <footer>— {data.testimonials.items[0].name}</footer>
          </blockquote>
          <a href="#testimonios" class="link-more">Ver más experiencias →</a>
        </aside>
      </div>

      <!-- Frase destacada -->
      <div class="hero-banner fade-in" style="--delay: 0.4s">
        <span class="banner-ornament">✦</span>
        <p class="banner-text">"{data.site.heroQuote}"</p>
        <span class="banner-ornament">✦</span>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         SOBRE MÍ
    ═══════════════════════════════════════════ -->
    <section id="sobremi" class="section section--about">
      <div class="section-inner">
        <div class="about-layout">
          <div class="about-text fade-in">
            <span class="section-eyebrow">Sobre mí</span>
            <h2 class="section-title">{data.about.heading}</h2>
            {data.about.paragraphs.map((p) => (
              <p class="body-text">{p}</p>
            ))}
            <div class="about-tags">
              {data.about.tags.map((tag) => (
                <span class="about-tag">{tag}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         HERRAMIENTAS
    ═══════════════════════════════════════════ -->
    <section id="herramientas" class="section section--tools">
      <div class="section-inner">
        <div class="section-header fade-in">
          <span class="section-eyebrow">Metodología</span>
          <h2 class="section-title">{data.tools.heading}</h2>
          <p class="section-intro">{data.tools.intro}</p>
        </div>

        <div class="tools-grid">
          {data.tools.items.map((tool, i) => (
            <div class="tool-card fade-in" style={`--delay: ${0.1 * i}s`}>
              {toolImages[tool.title] && (
                <div class="tool-image-wrap">
                  <Image
                    src={toolImages[tool.title]}
                    alt={tool.title}
                    class="tool-image"
                  />
                </div>
              )}
              <div class="tool-body">
                <div class="tool-icon">{tool.icon}</div>
                <h3 class="tool-title">{tool.title}</h3>
                <p class="tool-description">{tool.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         CÓMO TRABAJO
    ═══════════════════════════════════════════ -->
    <section class="section section--how">
      <div class="section-inner">
        <div class="how-layout fade-in">
          <div class="how-text">
            <span class="section-eyebrow">Mi enfoque</span>
            <h2 class="section-title">{data.howIWork.heading}</h2>
            <p class="body-text">{data.howIWork.body}</p>
          </div>
          <div class="how-pillars">
            {data.howIWork.pillars.map((pillar) => (
              <div class="pillar">
                <span class="pillar-icon">{pillar.icon}</span>
                <span class="pillar-label">{pillar.label}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="how-quote fade-in">
          <span class="how-quote-mark">"</span>
          <p>{data.site.aboutQuote}</p>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         TESTIMONIOS
    ═══════════════════════════════════════════ -->
    <section id="testimonios" class="section section--testimonials">
      <div class="section-inner">
        <div class="section-header fade-in">
          <span class="section-eyebrow">Comunidad</span>
          <h2 class="section-title">{data.testimonials.heading}</h2>
        </div>

        <div class="testimonials-grid">
          {data.testimonials.items.map((t, i) => (
            <div class="testimonial-card fade-in" style={`--delay: ${0.1 * i}s`}>
              <div class="testimonial-header">
                <span class="testimonial-name">{t.name}</span>
                {t.context && (
                  <span class="testimonial-context">{t.context}</span>
                )}
              </div>
              <p class="testimonial-text">{t.text}</p>
              {t.highlight && (
                <p class="testimonial-highlight">"{t.highlight}"</p>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         FOOTER
    ═══════════════════════════════════════════ -->
    <footer class="footer">
      <div class="footer-inner">
        <p>© {data.site.year} {data.site.title}. Todos los derechos reservados.</p>
        <p>
          Diseño y producción por{" "}
          <a href={data.site.authorUrl} target="_blank" class="footer-link">
            {data.site.author}
          </a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* ─── Reset & base ─── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --cream: #faf7f3;
    --cream-dark: #f5ede0;
    --plum: #2d1f3d;
    --plum-mid: #4a3a55;
    --plum-light: #6b5a6e;
    --terracotta: #8b6b59;
    --gold: #b89b8a;
    --border: rgba(139, 107, 89, 0.14);
    --radius: 16px;
    --section-pad: clamp(4rem, 8vw, 7rem);
  }

  html {
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
  }

  body {
    background-color: var(--cream);
    color: var(--plum);
    font-family: 'DM Sans', system-ui, sans-serif;
    line-height: 1.6;
  }

  /* ─── Fade-in ─── */
  .fade-in {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease var(--delay, 0s), transform 0.6s ease var(--delay, 0s);
  }
  .fade-in.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ─── Section scaffold ─── */
  .section {
    padding: var(--section-pad) 0;
  }

  .section-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 3rem;
  }

  .section-eyebrow {
    display: inline-block;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--terracotta);
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 600;
    color: var(--plum);
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .section-intro {
    font-size: 0.95rem;
    color: var(--plum-light);
    line-height: 1.7;
  }

  .body-text {
    font-size: 0.95rem;
    color: var(--plum-light);
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  /* ─── Buttons ─── */
  .btn-primary {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    background: var(--plum);
    color: var(--cream-dark);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: 100px;
    letter-spacing: 0.03em;
    transition: background 0.2s, transform 0.2s;
    margin-top: 0.5rem;
  }

  .btn-primary:hover {
    background: var(--plum-mid);
    transform: translateY(-2px);
  }

  .link-more {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--terracotta);
    text-decoration: none;
    letter-spacing: 0.03em;
    transition: color 0.2s;
  }

  .link-more:hover { color: var(--plum); }

  /* ═══════════════ HERO ═══════════════ */
  .hero {
    padding: 3rem 0 0;
  }

  .hero-grid {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: grid;
    grid-template-columns: 1fr 2fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  .hero-contact,
  .hero-review {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 2rem;
  }

  .contact-eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--terracotta);
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    color: var(--plum-mid);
    text-decoration: none;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    transition: background 0.2s, color 0.2s;
  }

  .contact-item:hover {
    background: rgba(139, 107, 89, 0.07);
    color: var(--plum);
  }

  .contact-icon { font-size: 1rem; }

  .hero-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .hero-image-wrap {
    position: relative;
    width: min(420px, 100%);
  }

  .hero-image {
    width: 100%;
    height: 520px;
    object-fit: cover;
    object-position: top;
    border-radius: 200px 200px 16px 16px;
    display: block;
  }

  .hero-image-ring {
    position: absolute;
    inset: -8px;
    border-radius: 208px 208px 20px 20px;
    border: 1px solid rgba(184, 155, 138, 0.35);
    pointer-events: none;
  }

  .hero-text {
    text-align: center;
    padding: 0 1rem;
  }

  .hero-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 600;
    color: var(--plum);
    line-height: 1.25;
    margin-bottom: 0.625rem;
  }

  .hero-subtitle {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    color: var(--plum-light);
    font-style: italic;
  }

  .hero-quote {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    color: var(--plum-light);
    line-height: 1.65;
  }

  .hero-quote p {
    margin-bottom: 0.75rem;
    font-style: italic;
  }

  .hero-quote footer {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--terracotta);
    font-style: normal;
  }

  .hero-banner {
    max-width: 1200px;
    margin: 2.5rem auto 0;
    padding: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    background: var(--plum);
    border-radius: 0;
  }

  .banner-text {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1rem, 2vw, 1.35rem);
    font-weight: 400;
    color: var(--cream-dark);
    font-style: italic;
    text-align: center;
    line-height: 1.5;
    flex: 1;
    max-width: 700px;
  }

  .banner-ornament {
    color: var(--gold);
    font-size: 1rem;
    flex-shrink: 0;
  }

  /* ═══════════════ ABOUT ═══════════════ */
  .section--about {
    background: #fff;
  }

  .about-layout {
    max-width: 700px;
    margin: 0 auto;
  }

  .about-text .section-title {
    margin-bottom: 1.5rem;
  }

  .about-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 1.5rem;
  }

  .about-tag {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--plum-mid);
    background: rgba(45, 31, 61, 0.06);
    padding: 0.4rem 1rem;
    border-radius: 100px;
    border: 1px solid var(--border);
  }

  /* ═══════════════ TOOLS ═══════════════ */
  .section--tools {
    background: var(--cream);
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .tool-card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.25s, box-shadow 0.25s;
  }

  .tool-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 32px rgba(45, 31, 61, 0.08);
  }

  .tool-image-wrap {
    aspect-ratio: 4/3;
    overflow: hidden;
  }

  .tool-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.4s ease;
    display: block;
  }

  .tool-card:hover .tool-image {
    transform: scale(1.04);
  }

  .tool-body {
    padding: 2rem 1.75rem;
  }

  .tool-icon {
    font-size: 2.25rem;
    margin-bottom: 1rem;
    line-height: 1;
  }

  .tool-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--plum);
    margin-bottom: 0.625rem;
  }

  .tool-description {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    color: var(--plum-light);
    line-height: 1.65;
  }

  /* ═══════════════ HOW I WORK ═══════════════ */
  .section--how {
    background: var(--cream-dark);
  }

  .how-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
    margin-bottom: 3rem;
  }

  .how-text .section-title {
    margin-bottom: 1rem;
  }

  .how-pillars {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1rem;
  }

  .pillar {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: transform 0.2s;
  }

  .pillar:hover { transform: translateY(-2px); }

  .pillar-icon { font-size: 1.5rem; }

  .pillar-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--plum-mid);
  }

  .how-quote {
    border-left: 2px solid var(--gold);
    padding-left: 1.75rem;
    position: relative;
    max-width: 600px;
    margin: 0 auto;
  }

  .how-quote-mark {
    position: absolute;
    top: -0.5rem;
    left: -0.25rem;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 4rem;
    color: var(--gold);
    opacity: 0.4;
    line-height: 1;
  }

  .how-quote p {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-style: italic;
    color: var(--plum-mid);
    line-height: 1.6;
  }

  /* ═══════════════ TESTIMONIALS ═══════════════ */
  .section--testimonials {
    background: var(--plum);
  }

  .section--testimonials .section-eyebrow {
    color: var(--gold);
  }

  .section--testimonials .section-title {
    color: var(--cream-dark);
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .testimonial-card {
    background: rgba(255, 252, 248, 0.06);
    border: 1px solid rgba(245, 237, 224, 0.12);
    border-radius: var(--radius);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: background 0.25s;
  }

  .testimonial-card:hover {
    background: rgba(255, 252, 248, 0.1);
  }

  .testimonial-header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .testimonial-name {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .testimonial-context {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.75rem;
    color: rgba(245, 237, 224, 0.5);
    font-style: italic;
  }

  .testimonial-text {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    color: rgba(245, 237, 224, 0.75);
    line-height: 1.7;
  }

  .testimonial-highlight {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1rem;
    font-style: italic;
    color: var(--cream-dark);
    line-height: 1.5;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(245, 237, 224, 0.1);
  }

  /* ═══════════════ FOOTER ═══════════════ */
  .footer {
    background: rgba(45, 31, 61, 0.96);
    border-top: 1px solid rgba(245, 237, 224, 0.08);
    padding: 1.5rem 0;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8rem;
    color: rgba(245, 237, 224, 0.45);
  }

  .footer-link {
    color: var(--gold);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-link:hover { color: var(--cream-dark); }

  /* ─── Responsive ─── */
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-contact,
    .hero-review {
      margin-top: 0;
      order: 2;
    }

    .hero-center {
      order: 1;
    }

    .hero-image {
      height: 380px;
    }

    .how-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 600px) {
    .footer-inner {
      flex-direction: column;
      text-align: center;
    }

    .how-pillars {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<script>
  // Intersection Observer para fade-in
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
        }
      });
    },
    { threshold: 0.12 }
  );

  document.querySelectorAll(".fade-in").forEach((el) => observer.observe(el));
</script>